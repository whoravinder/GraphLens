ENVIRONMENT=development
DEBUG=false

# === Local Docker Configuration ===
DATABASE_URL=postgresql+asyncpg://graphlens:graphlens@postgres:5432/graphlens
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=graphlens_incidents
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphlens123

# === Cloud Run Production Configuration (Examples) ===
# DATABASE_URL=postgresql+asyncpg://user:password@<CLOUD_SQL_IP>:5432/db_name
# QDRANT_URL=https://<QDRANT_CLOUD_CLUSTER_URL>:6333
# NEO4J_URI=neo4j+s://<AURA_DB_ID>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<AURA_PASSWORD>

OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CHUNK_SIZE=512
CHUNK_OVERLAP=100

TOP_K_RETRIEVAL=8
TOP_K_RERANK=4

ENABLE_RERANKING=true
RERANKER_MODEL=BAAI/bge-reranker-base

ENABLE_STREAMING=true
ENABLE_BM25=true
ENABLE_GRAPHRAG=true

GRAPH_MAX_DEPTH=3
GRAPH_MAX_RELATIONS=25

ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

MAX_CONTEXT_DOCUMENTS=20
MAX_GRAPH_NODES=50

AUTO_CREATE_COLLECTIONS=true
AUTO_CREATE_INDEXES=true
AUTO_SEED_ON_STARTUP=true

OPENAI_TIMEOUT_SECONDS=120

NVD_API_KEY=
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
MITRE_ATTACK_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json

RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=120

CORS_ORIGINS=["*"]

ENABLE_DOCS=true
ENABLE_PLAYGROUND=true

LOG_LEVEL=INFO
LOG_FORMAT=json
